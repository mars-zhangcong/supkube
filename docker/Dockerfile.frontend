# Build stage
# --platform=$BUILDPLATFORM (2026-06-01 ADR-042 follow-up):
# builder stage 永远在 native runner 平台跑，避免 arm64 build 走 QEMU emulate。
# Vite/esbuild 自动按 TARGET arch 下载 native binary，所以 output bundle 跨平台兼容。
# Final stage (nginx:1.25-alpine) 仍是 TARGETPLATFORM。
# 实测: 第一次 CD #1 frontend build 3m31s (vite 比 Go 略快，影响小但仍优化)。
FROM --platform=$BUILDPLATFORM node:20-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci

COPY . .
RUN npm run build

# Runtime stage
FROM nginx:1.25-alpine

# Pull latest alpine security patches (musl/xz/etc.) for the pinned base line
# so we don't ship known-fixed OS CVEs.
RUN apk upgrade --no-cache

RUN rm /etc/nginx/conf.d/default.conf

COPY --from=builder /app/dist /usr/share/nginx/html

# PRD-028 / ADR-056 v2: base-path entrypoint. Runs before nginx (after the
# stock 20-envsubst-on-templates.sh which expands ${BASE_PATH} in the mounted
# nginx template) to rewrite <base href>, the favicon and emit /config.js.
# POSIX sh, idempotent. At BASE_PATH=/ (default) it reproduces root behavior.
# NOTE: build context is ./supkube-frontend (see .github/workflows/{ci,cd}.yaml),
# so this path is relative to supkube-frontend/.
COPY docker/30-supkube-basepath.sh /docker-entrypoint.d/30-supkube-basepath.sh
RUN chmod +x /docker-entrypoint.d/30-supkube-basepath.sh

RUN printf 'server {\n\
    listen 80;\n\
    server_name _;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
\n\
    # Hashed asset files are content-addressed; safe to cache forever.\n\
    location ~* ^/assets/.*\\.(js|css|woff2?|ttf|otf|eot|svg|png|jpe?g|gif|ico)$ {\n\
        expires 1y;\n\
        add_header Cache-Control "public, immutable" always;\n\
        try_files $uri =404;\n\
    }\n\
\n\
    # index.html is the SPA shell; it must never be cached or users get\n\
    # stuck on a stale bundle pointing at deleted hashed assets.\n\
    location = /index.html {\n\
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;\n\
        add_header Pragma "no-cache" always;\n\
        expires off;\n\
    }\n\
\n\
    location / {\n\
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
\n\
    location /api/ {\n\
        proxy_pass http://supkube-backend:8080;\n\
        proxy_set_header Host $host;\n\
        proxy_set_header X-Real-IP $remote_addr;\n\
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
        proxy_set_header X-Forwarded-Proto $scheme;\n\
        # Backend is live K8S state; never cache. Safari is particularly\n\
        # aggressive about heuristic caching when responses omit Cache-Control,\n\
        # which is how SupKube 0.5.0 shipped — see ROADMAP v0.5.1 cache fix.\n\
        proxy_hide_header Cache-Control;\n\
        proxy_hide_header Pragma;\n\
        proxy_hide_header Expires;\n\
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;\n\
        add_header Pragma "no-cache" always;\n\
        expires off;\n\
    }\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
