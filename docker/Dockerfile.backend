# Build stage
FROM golang:1.21-alpine AS builder

RUN apk add --no-cache git

WORKDIR /app

# Cache dependencies
COPY go.mod go.sum ./
RUN go mod download

# Build
ARG CACHEBUST=20260519
COPY . .
RUN echo "cachebust=$CACHEBUST" && CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /supkube-backend .

# Runtime stage
FROM alpine:3.19

RUN apk add --no-cache ca-certificates tzdata

RUN adduser -D -u 1000 appuser
USER appuser

COPY --from=builder /supkube-backend /usr/local/bin/supkube-backend

EXPOSE 8080

ENTRYPOINT ["supkube-backend"]
