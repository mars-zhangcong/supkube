# Build stage
# v0.8.5: bumped from 1.21 → 1.25 because go-oidc/v3 v3.18 requires 1.25+
# (Go 1.25 has the synchronous mutex semantics go-jose v4 depends on).
FROM golang:1.25-alpine AS builder

RUN apk add --no-cache git

WORKDIR /app

# Cache dependencies
COPY go.mod go.sum ./
RUN go mod download

# Build
ARG CACHEBUST=20260519
ARG SUPKUBE_VERSION=0.8.10-alpha
# Multi-arch: TARGETARCH is set by Docker BuildKit (via `buildx --platform`)
# to amd64 / arm64 / etc. Without this, `go build` would default to the
# BUILD-platform arch — meaning a multi-arch buildx run would emit two
# identical binaries instead of one per target. Default to amd64 when
# building without buildx (plain `docker build`) so legacy callers still
# work. See hack/publish-release.sh for the buildx invocation.
ARG TARGETARCH=amd64
COPY . .
# Embed version + build-stamp via -ldflags -X. Lets /api/v1/status report
# what's actually running so users can confirm a `helm upgrade` rolled out.
# BuildStamp comes from `date -u +%y%m%d-%H%M` at build time.
RUN echo "cachebust=$CACHEBUST target=$TARGETARCH" && \
    BUILD_STAMP=$(date -u +%y%m%d-%H%M) && \
    CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build \
      -ldflags="-w -s \
        -X 'github.com/supkube/supkube-backend/internal/version.Version=${SUPKUBE_VERSION}' \
        -X 'github.com/supkube/supkube-backend/internal/version.BuildStamp=${BUILD_STAMP}'" \
      -o /supkube-backend .

# Runtime stage
FROM alpine:3.19

# apk upgrade first to pull the latest security patches for the pinned alpine
# line (e.g. musl/xz CVE fixes) so the image isn't shipped with known-fixed
# OS CVEs. Combined with add in one layer to keep the layer count down.
RUN apk upgrade --no-cache && apk add --no-cache ca-certificates tzdata

RUN adduser -D -u 1000 appuser
USER appuser

COPY --from=builder /supkube-backend /usr/local/bin/supkube-backend

EXPOSE 8080

ENTRYPOINT ["supkube-backend"]
